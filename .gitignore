# Secrets and local configuration — never committed (AGENTS.md §2.10)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data / scratch
data/local/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Frontend build artefacts (the app's own .gitignore covers the same ground; this is the
# belt to its braces, so a stray `npm install` at the repo root cannot be committed).
node_modules/
dist/
coverage/
