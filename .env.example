# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# Two audiences share this file:
#   SCANNER_*  — read by the application (config/settings.py), validated at startup.
#   POSTGRES_*/MINIO_*/LOCALSTACK_* — read by compose.yaml to provision the local stack.
# Nothing here has a fallback in code: a missing SCANNER_* value aborts startup, and a
# missing infrastructure credential aborts `docker compose up` (AGENTS.md §6).
#
# The values below are LOCAL DEVELOPMENT placeholders. Replace every credential before
# running against anything real.

# --- application ------------------------------------------------------------
SCANNER_ENV=dev                          # dev | staging | prod
SCANNER_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL (optional)
SCANNER_REGION=us-east-1                 # region for the S3/secrets clients (optional)

# Full DSN, password included — treated as a secret end to end.
SCANNER_DATABASE_URL=postgresql://scanner:change-me-locally@localhost:5433/scanner

# Raw-record object store (MinIO locally, any S3-compatible store on-prem).
SCANNER_RAW_STORE_ENDPOINT_URL=http://localhost:9000
SCANNER_RAW_STORE_BUCKET=scanner-raw
SCANNER_RAW_STORE_ACCESS_KEY_ID=scanner-local
SCANNER_RAW_STORE_SECRET_ACCESS_KEY=change-me-locally

# The vault inside the perimeter, behind SecretsPort (LocalStack Secrets Manager locally).
SCANNER_SECRETS_ENDPOINT_URL=http://localhost:4566

# Optional. The integration tests otherwise derive their database from SCANNER_DATABASE_URL by
# appending `_test` to the database name; they DROP and recreate whatever this points at, so
# never aim it at a database whose contents you want (ADR-0002).
# SCANNER_TEST_DATABASE_URL=postgresql://scanner:change-me-locally@localhost:5433/scanner_test

# --- local stack (compose.yaml) ---------------------------------------------
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433                       # host-side port; keep it in sync with SCANNER_DATABASE_URL

MINIO_ROOT_USER=scanner-local
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
